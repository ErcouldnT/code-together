# Local development. Coolify supplies its own values in production.
NODE_ENV=development
PORT=5000

# SQLite file. In Docker this lives on the `together-data` volume.
DATABASE_PATH=./data/together.db

# Delete rooms nobody has touched in N days. 0 (default) keeps everything.
DOCUMENT_TTL_DAYS=0

# Largest file that can be attached to a document, in bytes. Default 1 GB.
MAX_ATTACHMENT_BYTES=1073741824

# The password for /admin. Empty (default) turns the admin screen off entirely.
ADMIN_TOKEN=

# Where the limits start. Anything changed on the admin screen outranks these.
REQUESTS_PER_MINUTE=300
# Totals in bytes; 0 is no limit.
ATTACHMENT_QUOTA_BYTES=0
STORAGE_QUOTA_BYTES=0
